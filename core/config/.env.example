# ==========================================
# ENVIRONMENT
# ==========================================
ENV=dev

# ==========================================
# DJANGO
# ==========================================
# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Dev server port is not an env var, it's passed at runtime:
#   python manage.py runserver <PORT>
# Port 8000 is taken by XAMPP on this machine; 8010 is used instead.

# ==========================================
# PRESUPUESTOS DB - PROD
# ==========================================
PRESUPUESTOS_DB_HOST=
PRESUPUESTOS_DB_PORT=3306
PRESUPUESTOS_DB_USER=
PRESUPUESTOS_DB_PASSWORD=
PRESUPUESTOS_DB_NAME=

# ==========================================
# PRESUPUESTOS DB - DEV
# ==========================================
PRESUPUESTOS_DB_HOST_DEV=
PRESUPUESTOS_DB_PORT_DEV=3306
PRESUPUESTOS_DB_USER_DEV=
PRESUPUESTOS_DB_PASSWORD_DEV=
PRESUPUESTOS_DB_NAME_DEV=

# ==========================================
# ODOO (same instance as the Wansoft project)
# ==========================================
ODOO_URL=
ODOO_DB_NAME=
ODOO_USER=
ODOO_PASSWORD=
